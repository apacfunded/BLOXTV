# Copy to .env. Never commit .env.

# --- the show
ANTHROPIC_API_KEY=            # writes the scripts and the vote options (optional: template fallback)
HF_CREDENTIALS=               # console.higgsfield.ai -> API keys: paste the whole key (it looks like id:secret)
HF_RESOLUTION=480p            # 480p is ~3 credits/s and looks fine on phones; 720p ~7/s; 1080p ~16/s
ELEVENLABS_API_KEY=           # elevenlabs.io -> profile -> API keys
ELEVENLABS_VOICE_ID=          # the narrator voice you cloned in ElevenLabs (see README)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC for real traffic
DOMAIN=bloxtv.lol                                    # your domain; Caddy gets the HTTPS certificate for it
PUBLIC_URL=https://bloxtv.lol                        # where the site is reachable

# --- the stream (pump.fun -> your coin -> Start Livestream -> Generate RTMP Credentials)
RTMP_URL=
STREAM_KEY=
